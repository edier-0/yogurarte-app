{
  "$schema": "https://opencode.ai/schema/opencode.json",
  "instructions": [
    "AGENTS.md",
    "docs/constitution.md",
    "MEMORY.md"
  ],
  "agents": {
    "directory": ".opencode/agents"
  },
  "commands": {
    "directory": ".opencode/commands"
  },
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "context7-mcp@latest"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
