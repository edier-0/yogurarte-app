# ==============================================================================
# 🥛 YOGURARTE - ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env.example)
# ==============================================================================

# 🌐 Servidor Express
PORT=3000
NODE_ENV=production

# 🐘 Base de Datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/yogurarte_db?schema=public"

# ☁️ Base de Datos Neon (Cloud PostgreSQL) - ¡PROHIBIDO HARDCODEAR O COMMITEAR CREDENCIALES REALES!
NEON_DATABASE_URL="postgresql://usuario:contraseña@ep-endpoint-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 🔒 Seguridad y Autenticación JWT (Clave criptográfica de 256 bits)
JWT_SECRET="coloca_aqui_una_clave_secreta_aleatoria_de_64_caracteres"
JWT_EXPIRES_IN=1d

# 📧 Servicio de Correo Electrónico (SMTP para Códigos de Recuperación)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="tu_correo_emisor@gmail.com"
SMTP_PASS="tu_contraseña_de_aplicacion_gmail"
SMTP_FROM="YogurArte Seguridad <tu_correo_emisor@gmail.com>"
