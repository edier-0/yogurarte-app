datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String   @default("")
  pin       String   @default("1234")
  role      String   @default("ADMIN") // ADMIN, PRODUCCION, VENTAS, DOMICILIARIO
  phone     String?
  email     String?
  bankInfo  String?  // Nequi o cuenta bancaria
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Customer {
  id           Int      @id @default(autoincrement())
  fullName     String
  phone        String
  address      String
  neighborhood String?
  notes                String?
  loyaltyRedeemedCount Int                  @default(0)
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @default(now()) @updatedAt
  orders               Order[]
  conversations        ChatConversation[]
  recurringSchedules   RecurringSchedule[]

  @@index([fullName])
  @@index([phone])
  @@index([isActive])
  @@index([isActive, fullName])
}

model RawMaterial {
  id                         Int                     @id @default(autoincrement())
  code                       String                  @unique
  name                       String
  category                   String                  // MATERIA_PRIMA, EMPAQUE, INSUMO
  unit                       String                  // Litros, Unidades, Gramos, Kg, Kilogramos
  currentStock               Float                   @default(0)
  minStockAlert              Float                   @default(10)
  avgCost                    Float                   @default(0)
  isActive                   Boolean                 @default(true)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  purchases                  Purchase[]
  batchUsages                BatchItemUsage[]
  supplyPreparationsOutput   SupplyPreparation[]     @relation("OutputMaterial")
  supplyPreparationsUsed     SupplyPreparationItem[] @relation("IngredientMaterial")
  adjustments                InventoryAdjustment[]
  packagingUsages            BatchPackagingItem[]

  @@index([category])
  @@index([isActive])
  @@index([isActive, category])
}

model SupplyPreparation {
  id               Int                     @id @default(autoincrement())
  code             String                  @unique // PREP-20260817-01
  name             String                  // ej: Mermelada de Fresa Artesanal
  outputMaterialId Int
  outputMaterial   RawMaterial             @relation("OutputMaterial", fields: [outputMaterialId], references: [id])
  quantityProduced Float                   // ej: 3.2 kg
  unit             String                  @default("Kilogramos")
  totalCost        Float                   @default(0) // Suma de costos de ingredientes usados
  costPerUnit      Float                   @default(0) // totalCost / quantityProduced ($/kg o $/L)
  preparationDate  DateTime                @default(now())
  notes            String?
  registeredBy     String?
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @default(now()) @updatedAt
  ingredients      SupplyPreparationItem[]

  @@index([preparationDate])
  @@index([outputMaterialId])
  @@index([isActive])
}

model SupplyPreparationItem {
  id            Int               @id @default(autoincrement())
  preparationId Int
  preparation   SupplyPreparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  rawMaterialId Int
  rawMaterial   RawMaterial       @relation("IngredientMaterial", fields: [rawMaterialId], references: [id])
  quantityUsed  Float             // Cantidad consumida
  unitUsed      String            // g, kg, L, und
  unitCost      Float             // Costo unitario al momento de preparar
  totalCost     Float             // Costo total del insumo en la receta
  createdAt     DateTime          @default(now())

  @@index([preparationId])
  @@index([rawMaterialId])
}

model Purchase {
  id            Int          @id @default(autoincrement())
  rawMaterialId Int
  rawMaterial   RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  quantity      Float
  unitCost      Float
  totalCost     Float
  supplier      String?
  purchaseDate  DateTime     @default(now())
  paymentMethod String       @default("EFECTIVO") // EFECTIVO, TRANSFERENCIA, NEQUI, BANCOLOMBIA
  notes         String?
  registeredBy  String?
  createdAt     DateTime     @default(now())

  @@index([purchaseDate])
  @@index([rawMaterialId])
  @@index([paymentMethod])
  @@index([purchaseDate, rawMaterialId])
}

model InventoryAdjustment {
  id              Int          @id @default(autoincrement())
  rawMaterialId   Int
  rawMaterial     RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  type            String       // CONTEO_FISICO, MERMA_DANO, CONSUMO_PRUEBA, SOBRANTE, CORRECCION
  previousStock   Float
  newStock        Float
  deltaQuantity   Float        // newStock - previousStock
  unit            String
  unitCost        Float        // Costo promedio unitario al momento del ajuste
  totalCostImpact Float        // deltaQuantity * unitCost ($ COP)
  reason          String?
  registeredBy    String?
  adjustmentDate  DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@index([adjustmentDate])
  @@index([rawMaterialId])
  @@index([type])
}

model ProductionBatch {
  id                  Int               @id @default(autoincrement())
  batchCode           String            @unique
  milkUsedLiters      Float
  bottles1LProduced   Int               @default(0)
  bottles2LProduced   Int               @default(0)
  totalLitersProduced Float
  yieldPercentage     Float
  flavor              String            @default("Natural")
  price1L             Float             @default(12000)
  price2L             Float             @default(24000)
  status              String            @default("COMPLETADO") // COMPLETADO, AGOTADO, EN_FERMENTACION, DESCARTADO, DISPONIBLE
  cultureType         String?
  fermentationHours   Float?            @default(8)
  initialSugarGrams   Float?            @default(0)
  powderedMilkGrams   Float?            @default(0)
  packagedLiters      Float             @default(0)
  preparationDate     DateTime          @default(now())
  expirationDate      DateTime?
  totalCost           Float             @default(0)
  costPerLiter        Float             @default(0)
  notes               String?
  registeredBy        String?
  isActive            Boolean           @default(true)
  deactivationReason  String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now()) @updatedAt
  itemsUsed           BatchItemUsage[]
  orders              Order[]
  orderItems          OrderItem[]
  discharges          BatchDischarge[]
  packagings          BatchPackaging[]

  @@index([preparationDate])
  @@index([flavor])
  @@index([status])
  @@index([isActive])
  @@index([isActive, status])
  @@index([isActive, preparationDate])
}

model BatchPackaging {
  id                 Int              @id @default(autoincrement())
  packagingCode      String?
  batchId            Int
  batch              ProductionBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  flavor             String
  bottles1L          Int                  @default(0)
  bottles2L          Int                  @default(0)
  totalLiters        Float
  price1L            Float?               @default(12000)
  price2L            Float?               @default(24000)
  fruitRawMaterialId Int?
  fruitQuantityUsed  Float?           @default(0)
  fruitUnitCost      Float?           @default(0)
  packagingCost      Float            @default(0)
  notes              String?
  packagedBy         String?          @default("Edier")
  packagedAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  itemsUsed          BatchPackagingItem[]

  @@index([batchId])
  @@index([flavor])
  @@index([packagedAt])
}

model BatchPackagingItem {
  id             Int            @id @default(autoincrement())
  packagingId    Int
  packaging      BatchPackaging @relation(fields: [packagingId], references: [id], onDelete: Cascade)
  rawMaterialId  Int
  rawMaterial    RawMaterial    @relation(fields: [rawMaterialId], references: [id])
  quantityUsed   Float
  unitCost       Float          @default(0)
  totalCost      Float          @default(0)
  dosagePerLiter Float?
  dosageUnit     String?
  createdAt      DateTime       @default(now())

  @@index([packagingId])
  @@index([rawMaterialId])
}

model BatchDischarge {
  id             Int              @id @default(autoincrement())
  batchId        Int
  batch          ProductionBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  bottleSize     String           @default("1L") // 1L, 2L, OTRA
  quantityBottles Int             @default(1)
  totalLiters    Float            // ej: 1.0, 2.0
  unitPrice      Float            @default(12000)
  totalAmount    Float            @default(12000) // totalLiters * unitPrice
  reasonType     String           // CONSUMO_SOCIO, MUESTRA_DEGUSTACION, MERMA_DANO, CORTESIA, OTRO
  staffMemberId  Int?             // Socio asignado si es CONSUMO_SOCIO
  staffMember    StaffMember?     @relation(fields: [staffMemberId], references: [id])
  staffPaymentId Int?             // Id del pago/retiro en especie generado en StaffPayment
  notes          String?
  registeredBy   String?          @default("Edier")
  dischargeDate  DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  @@index([batchId])
  @@index([dischargeDate])
  @@index([reasonType])
  @@index([staffMemberId])
}

model BatchItemUsage {
  id            Int             @id @default(autoincrement())
  batchId       Int
  batch         ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rawMaterialId Int
  rawMaterial   RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  quantityUsed  Float
  unitCost      Float           @default(0)
  totalCost     Float           @default(0)
  createdAt     DateTime        @default(now())

  @@index([batchId])
  @@index([rawMaterialId])
}

model Order {
  id              Int              @id @default(autoincrement())
  orderNumber     String           @unique
  customerId      Int
  customer        Customer         @relation(fields: [customerId], references: [id])
  batchId         Int?
  batch           ProductionBatch? @relation(fields: [batchId], references: [id])
  bottleSize      String           @default("1L") // 1L, 2L, MIXTO
  quantityBottles Int              @default(1)
  totalLiters     Float            @default(1)
  flavor          String           @default("Natural")
  unitPrice       Float            @default(12000)
  totalAmount     Float
  paidAmount      Float            @default(0)
  pendingAmount   Float            @default(0)
  paymentStatus   String           @default("PENDING") // PENDING, PARTIAL, PAID
  paymentMethod   String           @default("EFECTIVO") // EFECTIVO, TRANSFERENCIA, NEQUI, BANCOLOMBIA
  deliveryStatus  String           @default("PENDING") // PENDING, PREPARING, IN_ROUTE, DELIVERED, CANCELLED
  deliveryType    String           @default("PROPIO")  // PROPIO, DOMICILIARIO, LOCAL
  deliveryDriverId Int?
  deliveryDriverName String?
  deliveryFee     Float            @default(0) // Valor/costo del servicio de domicilio ($ COP)
  discount        Float            @default(0) // Descuento global aplicado al pedido ($ COP)
  dispatchedAt    DateTime?
  orderDate       DateTime         @default(now())
  deliveryDate    DateTime?
  deliveryAddress String?
  notes           String?
  registeredBy    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  items           OrderItem[]
  payments        OrderPayment[]

  @@index([orderDate])
  @@index([deliveryDate])
  @@index([customerId])
  @@index([batchId])
  @@index([paymentStatus])
  @@index([deliveryStatus])
  @@index([deliveryDate, deliveryStatus])
  @@index([customerId, orderDate])
  @@index([deliveryStatus, orderDate])
  @@index([paymentStatus, orderDate])
  @@index([createdAt])
}

model OrderPayment {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Float
  paymentDate   DateTime @default(now())
  paymentMethod String   @default("EFECTIVO") // EFECTIVO, NEQUI, BANCOLOMBIA, TRANSFERENCIA
  notes         String?
  registeredBy  String?  @default("Edier")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([paymentDate])
  @@index([orderId])
  @@index([paymentMethod])
}

model OrderItem {
  id            Int              @id @default(autoincrement())
  orderId       Int
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  batchId       Int?
  batch         ProductionBatch? @relation(fields: [batchId], references: [id])
  bottleSize    String           @default("1L") // 1L, 2L
  flavor        String           @default("Natural")
  quantity      Int              @default(1)
  litersPerUnit Float            @default(1.0)
  totalLiters   Float            @default(1.0)
  unitPrice     Float            @default(12000)
  totalPrice    Float            @default(12000)
  createdAt     DateTime         @default(now())

  @@index([orderId])
  @@index([batchId])
}

model Expense {
  id            Int      @id @default(autoincrement())
  category      String   // INFRAESTRUCTURA, SERVICIOS, TRANSPORTE, PUBLICIDAD, INSUMOS_EXTRA, OTRO
  description   String
  amount        Float
  expenseDate   DateTime @default(now())
  paymentMethod String   @default("EFECTIVO") // EFECTIVO, TRANSFERENCIA, NEQUI, BANCOLOMBIA
  notes         String?
  registeredBy  String?
  createdAt     DateTime @default(now())

  @@index([expenseDate])
  @@index([category])
  @@index([paymentMethod])
  @@index([expenseDate, category])
}

model StaffMember {
  id            Int            @id @default(autoincrement())
  fullName      String
  phone         String?
  role          String         @default("PRODUCCION") // SOCIO, PRODUCCION, DOMICILIARIO, VENTAS, AUXILIAR
  type          String         @default("EMPLEADO")   // SOCIO, EMPLEADO
  paymentScheme String         @default("LIBRE")      // FIJO, POR_DIA, POR_LITRO, POR_PEDIDO, LIBRE
  defaultRate   Float?         @default(0)
  bankInfo      String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  payments        StaffPayment[]
  batchDischarges BatchDischarge[]

  @@index([role])
  @@index([type])
  @@index([isActive])
}

model StaffPayment {
  id                 Int         @id @default(autoincrement())
  staffId            Int
  staff              StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  paymentType        String      @default("NOMINA") // NOMINA, RETIRO_SOCIO, ANTICIPO, BONIFICACION
  amount             Float       // Monto bruto
  deductions         Float       @default(0) // Descuentos / anticipos
  netAmount          Float       // Monto efectivamente pagado
  periodStart        DateTime?
  periodEnd          DateTime?
  paymentDate        DateTime    @default(now())
  calculationDetails String?     // Ej: "3 días x $40.000" o "Retiro utilidades"
  paymentMethod      String      @default("EFECTIVO") // EFECTIVO, NEQUI, BANCOLOMBIA, TRANSFERENCIA
  notes              String?
  registeredBy       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt

  @@index([paymentDate])
  @@index([staffId])
  @@index([paymentType])
  @@index([paymentDate, staffId])
}

model CashMovement {
  id            Int      @id @default(autoincrement())
  type          String   // BASE_INICIAL, APORTE_SOCIO, RETIRO_BASE, AJUSTE_CAJA
  amount        Float
  movementDate  DateTime @default(now())
  concept       String   // ej: "Base para dar vuelto", "Aporte de bolsillo para comprar etiquetas y envases"
  paymentMethod String   @default("EFECTIVO") // EFECTIVO, NEQUI, BANCOLOMBIA, TRANSFERENCIA
  registeredBy  String?  @default("Edier")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([movementDate])
  @@index([type])
  @@index([paymentMethod])
  @@index([movementDate, type])
}

model CreditObligation {
  id                Int             @id @default(autoincrement())
  title             String          // Ej: "Congelador 400L", "Selladora", "Adecuación Local", "Moto de Reparto"
  category          String          @default("EQUIPO_MAQUINARIA") // EQUIPO_MAQUINARIA, INFRAESTRUCTURA_LOCAL, TRANSPORTE_VEHICULO, HERRAMIENTAS, OTRO
  creditor          String          // Proveedor, almacén, persona o banco acreedor
  principalAmount   Float           // Valor base / contado
  interestRate      Float           @default(0) // Porcentaje de interés (%)
  totalAmount       Float           // Valor total financiado (principal + interés)
  initialPayment    Float           @default(0) // Cuota inicial pagada de contado
  remainingBalance  Float           // Saldo pendiente por pagar
  paymentType       String          @default("CUOTAS_FIJAS") // CUOTAS_FIJAS, ABONOS_LIBRES
  frequency         String          @default("MENSUAL") // DIARIA, SEMANAL, QUINCENAL, MENSUAL, LIBRE
  installmentAmount Float           @default(0) // Valor sugerido de cuota periódica
  totalInstallments Int?            // Número total de cuotas acordadas
  paidInstallments  Int             @default(0) // Cuotas/abonos realizados
  startDate         DateTime        @default(now()) // Fecha de compra/crédito
  nextDueDate       DateTime?       // Próximo vencimiento
  status            String          @default("ACTIVO") // ACTIVO, PAGADO_TOTAL, CANCELADO
  notes             String?         // Factura, garantía, observaciones
  registeredBy      String?         @default("Edier")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
  payments          CreditPayment[]

  @@index([status])
  @@index([startDate])
  @@index([nextDueDate])
}

model CreditPayment {
  id                Int              @id @default(autoincrement())
  creditId          Int
  credit            CreditObligation @relation(fields: [creditId], references: [id], onDelete: Cascade)
  actionType        String           @default("PAGO_CUOTA") // PAGO_CUOTA, ABONO_EXTRAORDINARIO, CUOTA_OMITIDA_APLAZADA
  amount            Float            // Monto pagado ($0 si fue omitida)
  paymentDate       DateTime         @default(now())
  paymentMethod     String           @default("EFECTIVO") // EFECTIVO, TRANSFERENCIA, NEQUI, BANCOLOMBIA
  installmentNumber Int?             // Número de cuota
  justification     String?          // Motivo si fue omitida o nota de abono
  receiptNumber     String?          // Comprobante
  registeredBy      String?          @default("Edier")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  @@index([paymentDate])
  @@index([creditId])
  @@index([actionType])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// ==========================================
// 💬 CRM Y MENSAJERÍA DE WHATSAPP MULTI-AGENTE
// ==========================================

model ChatConversation {
  id                    Int           @id @default(autoincrement())
  remoteJid             String        @unique // Identificador de WhatsApp: 57300xxxxxxx@s.whatsapp.net
  phoneNumber           String        // Número telefónico formateado
  contactName           String?       // Nombre del contacto en WhatsApp
  profilePicUrl         String?       // Foto de perfil
  unreadCount           Int           @default(0)
  lastMessageText       String?
  lastMessageTimestamp  DateTime?
  lastMessageFromMe     Boolean       @default(false)
  isArchived            Boolean       @default(false)
  isPinned              Boolean       @default(false)
  tag                   String        @default("NUEVO") // NUEVO, INTERESADO, PEDIDO_ACTIVO, CLIENTE_FRECUENTE, SEGUIMIENTO
  customerId            Int?
  customer              Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @default(now()) @updatedAt
  messages              ChatMessage[]

  @@index([remoteJid])
  @@index([phoneNumber])
  @@index([lastMessageTimestamp])
  @@index([customerId])
  @@index([unreadCount])
  @@index([tag])
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String           @unique // ID del mensaje de Baileys / WAMessage
  fromMe         Boolean          @default(false)
  senderName     String?
  messageType    String           @default("TEXT") // TEXT, IMAGE, AUDIO, VIDEO, DOCUMENT, LOCATION, STICKER
  text           String?
  mediaUrl       String?
  mediaMimeType  String?
  status         String           @default("DELIVERED") // PENDING, SENT, DELIVERED, READ, ERROR
  timestamp      DateTime         @default(now())
  createdAt      DateTime         @default(now())

  @@index([conversationId])
  @@index([conversationId, timestamp(sort: Desc)])
  @@index([messageId])
  @@index([timestamp])
  @@index([fromMe])
}

model WhatsAppAuthSession {
  id        String   @id // Formato: "main:creds", "main:pre-key-1"
  sessionId String   @default("main")
  keyId     String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([sessionId, keyId])
  @@index([sessionId])
}

model RecurringSchedule {
  id              Int       @id @default(autoincrement())
  customerId      Int
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  frequencyDays   Int       @default(15) // 7 (semanal), 15 (quincenal), 30 (mensual)
  preferredFlavor String    @default("Fresa")
  bottleSize      String    @default("1L") // 1L, 2L
  quantity        Int       @default(1)
  nextDate        DateTime
  lastOrderDate   DateTime?
  notes           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([customerId])
  @@index([nextDate])
  @@index([isActive])
}

model CrmQuickReply {
  id        Int      @id @default(autoincrement())
  shortcut  String   @unique // /sabores, /precios, /pago, /saludo, /domicilio
  title     String
  content   String   @db.Text
  category  String   @default("VENTAS") // VENTAS, PAGOS, GENERAL, INFO
  mediaUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([category])
}

model ProductFlavor {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
  @@index([name])
}



